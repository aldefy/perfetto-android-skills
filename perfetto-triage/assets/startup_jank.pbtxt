# Perfetto TraceConfig for Android startup + jank + binder triage.
#
# Use this, not the lightweight `adb shell perfetto <categories>` form:
# the lightweight form CANNOT enable android.surfaceflinger.frametimeline,
# which means no jank attribution at all.
#
#   cat startup_jank.pbtxt | adb shell perfetto -c - --txt \
#       -o /data/misc/perfetto-traces/trace.pftrace
#   adb pull /data/misc/perfetto-traces/trace.pftrace
#
# FrameTimeline requires Android 12 (API 31) or newer.

buffers {
  size_kb: 131072
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 16384
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      # atrace categories: userspace tracepoints from the framework and app.
      atrace_categories: "am"             # ActivityManager - launch lifecycle
      atrace_categories: "wm"             # WindowManager
      atrace_categories: "gfx"            # graphics, doFrame, DrawFrame
      atrace_categories: "view"           # measure / layout / draw
      atrace_categories: "ss"             # system_server
      atrace_categories: "sm"             # sync manager
      atrace_categories: "dalvik"         # ART: class load, JIT, GC
      atrace_categories: "binder_driver"
      atrace_categories: "binder_lock"
      atrace_categories: "aidl"           # names the AIDL method, not just "binder transaction"
      atrace_categories: "input"
      atrace_categories: "res"
      atrace_categories: "pm"
      atrace_categories: "database"
      atrace_apps: "*"                    # replace * with your package for less noise

      # ftrace: kernel truth about running vs waiting.
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "sched/sched_blocked_reason"   # populates blocked_function
      ftrace_events: "sched/sched_process_exit"
      ftrace_events: "sched/sched_process_free"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_idle"
      ftrace_events: "power/suspend_resume"
      ftrace_events: "binder/binder_transaction"
      ftrace_events: "binder/binder_transaction_received"
      ftrace_events: "binder/binder_transaction_alloc_buf"
      ftrace_events: "binder/binder_set_priority"
      symbolize_ksyms: true
    }
  }
}

# Without this there is no jank data. This is the single most commonly
# forgotten line in an Android trace config.
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
    target_buffer: 1
  }
}

data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
    }
  }
}

data_sources {
  config {
    name: "linux.sys_stats"
    target_buffer: 1
    sys_stats_config {
      cpufreq_period_ms: 250
    }
  }
}

data_sources {
  config {
    name: "android.packages_list"
    target_buffer: 1
  }
}

data_sources {
  config {
    name: "android.log"
    target_buffer: 1
    android_log_config {
      log_ids: LID_EVENTS
      log_ids: LID_CRASH
      log_ids: LID_SYSTEM
    }
  }
}

duration_ms: 20000
